# ── Google OAuth ────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Discord OAuth ───────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → Your App → OAuth2
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# ── Session / JWT signing secret ────────────────────────────────────────────
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── Database (Prisma) ────────────────────────────────────────────────────────
# PostgreSQL connection string — set this once your DB is provisioned
# Local example:  postgresql://postgres:password@localhost:5432/demo_game
# Render example: set from the Render PostgreSQL add-on "Internal Database URL"
DATABASE_URL=postgresql://postgres:password@localhost:5432/demo_game

# ── Server URLs (auto-set in render.yaml for production) ────────────────────
SERVER_HTTP_URL=http://localhost:10001
SERVER_WS_URL=ws://localhost:10001

# ── Optional tuning ─────────────────────────────────────────────────────────
NODE_ENV=development
AUTH_SESSION_TTL_MS=604800000
