{
  "name": "ps1-game-server",
  "version": "0.3.0",
  "description": "WebSocket server for PS1 game engine",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ../node_modules/ts-node/dist/bin.js -r tsconfig-paths/register src/index.ts",
    "build": "node ../node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "type-check": "node ../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@shared/contracts": "file:../packages/shared-contracts",
    "express": "^4.18.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.9.0",
    "@types/ws": "^8.5.7",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
